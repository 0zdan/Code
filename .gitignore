def caesar_decrypt(ciphertext):
    alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
    ciphertext = ciphertext.upper()
    possible_plaintexts = []

    for shift in range(1, 26):  # 1 to 25
        plaintext = ''
        for char in ciphertext:
            if char in alphabet:
                index = (alphabet.index(char) - shift) % 26
                plaintext += alphabet[index]
            else:
                plaintext += char
        possible_plaintexts.append((shift, plaintext))

    return possible_plaintexts

# Example usage
cipher = "WKH TXLFN EURZQ IRA MXPSV RYHU WKH ODCB GRJ"
results = caesar_decrypt(cipher)

for shift, plain in results:
    print(f"Shift {shift}: {plain}")
